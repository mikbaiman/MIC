# Preserve every upstream segmentation requirement, including CUDA 11.0.
-r ../../seg/requirements.txt
# README requires this after the other requirements. Use the matching official
# prebuilt extension to avoid requiring a local CUDA 11.0 compiler.
mmcv-full @ https://download.openmmlab.com/mmcv/dist/cu110/torch1.7.0/mmcv_full-1.3.7-cp38-cp38-manylinux1_x86_64.whl
# Keep the original interpreter's LibreSSL usable with requests.
urllib3<2
setuptools==59.5.0
